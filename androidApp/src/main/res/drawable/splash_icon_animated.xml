<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- Background with radial gradient -->
            <path android:pathData="M0,0h108v108h-108z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:centerX="54"
                        android:centerY="54"
                        android:gradientRadius="54"
                        android:type="radial">
                        <item android:color="#FF1A237E" android:offset="0.0" />
                        <item android:color="#FF3949AB" android:offset="0.5" />
                        <item android:color="#FF5C6BC0" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>

            <!-- Inner circle (r=12) - static -->
            <path
                android:fillColor="#00000000"
                android:pathData="M54,54m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFFFF" />

            <!-- Outer circle (r=24) - static -->
            <path
                android:fillColor="#00000000"
                android:pathData="M54,54m-24,0a24,24 0,1 1,48 0a24,24 0,1 1,-48 0"
                android:strokeWidth="3"
                android:strokeColor="#FFFFFFFF" />

            <!-- Ping ring 1 (r=50) -->
            <group
                android:name="ping_1"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:name="ping_1_ring"
                    android:fillColor="#00000000"
                    android:pathData="M54,54m-50,0a50,50 0,1 1,100 0a50,50 0,1 1,-100 0"
                    android:strokeWidth="1.5"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeAlpha="0" />
            </group>

            <!-- Ping ring 2 (r=50) -->
            <group
                android:name="ping_2"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:name="ping_2_ring"
                    android:fillColor="#00000000"
                    android:pathData="M54,54m-50,0a50,50 0,1 1,100 0a50,50 0,1 1,-100 0"
                    android:strokeWidth="1.5"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeAlpha="0" />
            </group>

            <!-- Ping ring 3 (r=50) -->
            <group
                android:name="ping_3"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:name="ping_3_ring"
                    android:fillColor="#00000000"
                    android:pathData="M54,54m-50,0a50,50 0,1 1,100 0a50,50 0,1 1,-100 0"
                    android:strokeWidth="1.5"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeAlpha="0" />
            </group>

        </vector>
    </aapt:attr>

    <!-- Ping 1: scale 0→1, starts at 0ms -->
    <target android:name="ping_1">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1800"
                    android:repeatCount="infinite"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1800"
                    android:repeatCount="infinite"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ping_1_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0.4"
                android:valueTo="0"
                android:duration="1800"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>

    <!-- Ping 2: scale 0→1, starts at 600ms -->
    <target android:name="ping_2">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1800"
                    android:startOffset="600"
                    android:repeatCount="infinite"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1800"
                    android:startOffset="600"
                    android:repeatCount="infinite"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ping_2_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0.4"
                android:valueTo="0"
                android:duration="1800"
                android:startOffset="600"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>

    <!-- Ping 3: scale 0→1, starts at 1200ms -->
    <target android:name="ping_3">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1800"
                    android:startOffset="1200"
                    android:repeatCount="infinite"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:duration="1800"
                    android:startOffset="1200"
                    android:repeatCount="infinite"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="ping_3_ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0.4"
                android:valueTo="0"
                android:duration="1800"
                android:startOffset="1200"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>

</animated-vector>
